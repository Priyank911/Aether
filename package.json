{
  "name": "aether-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Aether: Authentic Agentic Browser Engine",
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm --filter @aether/extension run prepare && tsc --build --verbose",
    "lint": "node scripts/lint.mjs",
    "lint:native": "biome lint .",
    "test": "pnpm extension:build && tsc --build apps/cli && vitest run",
    "test:watch": "vitest",
    "probe": "tsx apps/cli/src/index.ts probe",
    "mcp": "tsx apps/cli/src/index.ts mcp",
    "demo": "tsx scripts/demo-live.ts",
    "extension:build": "pnpm --filter @aether/extension build",
    "native-host:build": "pnpm --filter @aether/native-host build",
    "mcp:build": "tsc --build apps/cli",
    "setup:build": "tsc --build apps/cli apps/native-host && pnpm extension:build",
    "doctor": "tsc --build apps/cli && node apps/cli/dist/index.js doctor"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@biomejs/js-api": "6.1.0",
    "@biomejs/wasm-nodejs": "2.6.4",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  }
}
